# نمونه پیکربندی — کپی به .env و مقدارها را تنظیم کنید

# پایگاه داده (در docker-compose خودکار ست می‌شود؛ برای اجرای محلی SQLite بماند)
S360_DATABASE_URL=postgresql+psycopg://s360:s360_pass@localhost:5432/student360

# امنیت — در استقرار واقعی حتماً عوض شود (حداقل ۳۲ کاراکتر تصادفی)
S360_JWT_SECRET=change-me-please-with-a-long-random-string-32+

# هوش مصنوعی — mock برای توسعه بدون اینترنت؛ openai_compat برای مدل واقعی
S360_AI_PROVIDER=mock
S360_AI_BASE_URL=
S360_AI_API_KEY=
S360_AI_MODEL=
S360_AI_DAILY_TOKEN_BUDGET=2000000

# سیاست‌های آموزشی دانشگاه
S360_TA_CAN_PUBLISH=false
S360_MASTERY_MIN_EVIDENCE=3

# مسیر ذخیره فایل‌ها و CORS
S360_STORAGE_DIR=./data/storage
S360_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
