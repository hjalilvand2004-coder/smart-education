# نمونه پیکربندی — کپی به .env و مقدارها را تنظیم کنید

# پایگاه داده (در docker-compose خودکار ست می‌شود؛ برای اجرای محلی SQLite بماند)
S360_DATABASE_URL=postgresql+psycopg://s360:s360_pass@localhost:5432/student360

# امنیت — در استقرار واقعی حتماً عوض شود (حداقل ۳۲ کاراکتر تصادفی)
S360_JWT_SECRET=change-me-please-with-a-long-random-string-32+

# هوش مصنوعی — mock برای توسعه بدون اینترنت؛ openai_compat برای مدل واقعی
S360_AI_PROVIDER=mock
S360_AI_BASE_URL=
S360_AI_API_KEY=
S360_AI_MODEL=
S360_AI_DAILY_TOKEN_BUDGET=2000000

# سیاست‌های آموزشی دانشگاه
S360_TA_CAN_PUBLISH=false
S360_MASTERY_MIN_EVIDENCE=3

# یکپارچگی کامل پایه‌یار۳۶۰ (سند فنی اتصال v3.4.0) — سرویس «PayehYar360»
# endpoint اکوسیستم: GET /api/v1/services/masterdata/{domain} با هدر X-API-Key.
# کلید را در پایه‌یار۳۶۰ (بخش سرویس‌کلاینت‌ها) صادر کنید؛ بدون کلید، صفحه
# «همگام‌سازی پایه‌یار» وضعیت دقیق + راهنمای اقدام را نشان می‌دهد.
# جایگزین حالت توسعه: کاربر دارای نقش steward/tenant_admin در سرویس مرجع
S360_PAYEHYAR_BASE_URL=http://188.212.96.235:8094
S360_PAYEHYAR_API_KEY=
S360_PAYEHYAR_DEV_USER=
S360_PAYEHYAR_HTTP_TIMEOUT_SECONDS=30

# احراز OAuth2 client_credentials طبق سند فنی (جایگزین/مکمل کلید API) —
# secret فقط اینجا قرار می‌گیرد و هرگز در مخزن منتشر نمی‌شود.
S360_PAYEHYAR_CLIENT_ID=smart-learning
S360_PAYEHYAR_CLIENT_SECRET=
S360_PAYEHYAR_TOKEN_ENDPOINT=http://188.212.96.235:8086/oauth/token
S360_PAYEHYAR_OAUTH_SCOPE=masterdata.read

# HTTP سند فنی: timeout 30 + retry نمایی (حداکثر ۵ تلاش روی 502/503/504)
S360_PAYEHYAR_RETRY_MAX_ATTEMPTS=5
S360_PAYEHYAR_RETRY_BACKOFF_SECONDS=1

# همگام‌سازی خودکار — معادل cron «0 */30 * * * *» سند فنی (هر ۳۰ دقیقه).
# در استقرار واقعی با داشتن کلید API، true کنید.
S360_PAYEHYAR_AUTO_SYNC=false
S360_PAYEHYAR_SYNC_INTERVAL_SECONDS=1800
S360_PAYEHYAR_ETAG_CACHE=true
S360_PAYEHYAR_EXTENDED_DOMAINS=professors,classrooms,academic-groups,reference-sets

# رویدادهای RabbitMQ — صف اختصاصی + DLQ + پردازش idempotent (جدول inbox).
# کاربر اختصاصی و رمز را از مدیر پایه‌یار دریافت و فقط اینجا تنظیم کنید؛
# تا آن زمان رویدادها غیرفعال‌اند و همگام‌سازی HTTP مستقل کار می‌کند.
S360_PAYEHYAR_EVENTS_ENABLED=false
S360_PAYEHYAR_RABBITMQ_HOST=188.212.96.235
S360_PAYEHYAR_RABBITMQ_PORT=5672
S360_PAYEHYAR_RABBITMQ_USER=
S360_PAYEHYAR_RABBITMQ_PASSWORD=
S360_PAYEHYAR_RABBITMQ_EXCHANGE=payehyar.events
S360_PAYEHYAR_RABBITMQ_QUEUE=smart-learning.masterdata.q
S360_PAYEHYAR_RABBITMQ_ROUTING_KEY=payehyar.masterdata.#
S360_PAYEHYAR_RABBITMQ_DLQ=smart-learning.masterdata.q.dlq

# مسیر ذخیره فایل‌ها و CORS
S360_STORAGE_DIR=./data/storage
S360_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
